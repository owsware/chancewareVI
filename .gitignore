# ---------------------------------------------------------------------------
# RULE #1: nothing from the game (or any other proprietary source) is ever
# committed.
# Everything is built from files the user supplies at runtime.
# Ignore rules and `cargo xtask policy` help prevent accidental commits.
# They do not protect tracked files, history, or force-added content.
# See the asset policy in README.md.
# ---------------------------------------------------------------------------

# Build output
/target/
/tests/fixtures/*/target/

# Keep local notes out of new commits. Existing tracked notes are excluded
# from source exports by .gitattributes; ignore rules do not untrack them.
*.md
!/README.md
!/AGENTS.md

# Local configuration (contains paths to YOUR files)
/victory.toml
/game-path.txt
/state/
/.local/
/.secrets/
.env
.env.*
.netrc
*.pem
*.key
*.pfx
*.p12

# Places people tend to drop data into. Keep data outside the repo instead.
/game/
/games/
/assets/
/data/
/dump/
/dumps/
/extracted/
/cache/
/out/
/logs/
/captures/
/refused-shaders/
/graphify-out/

# Local diagnostics, GPU captures, and analysis databases
*.log
*.dmp
*.mdmp
*.etl
*.rdc
*.wpix
*.idb
*.i64
*.id[012]
*.nam
*.til
*.gpr
*.rep/

# Executables, libraries, symbols
*.exe
*.dll
*.pdb
*.lib
*.sys
*.obj
*.exp
*.ilk

# Console packages and containers
*.xvd
*.xvc
*.msixvc
*.xsp
*.cab
*.msi

# Typical game data (non-exhaustive on purpose; the policy check is an allowlist)
*.bin
# A local copy of the separately supplied BCPack tables stays ignored.
*.dat
*.pak
*.rpf
*.dds
*.ktx
*.ktx2
*.png
*.jpg
*.jpeg
*.webp
*.bmp
*.gif
*.dxbc
*.dxil
*.cso
*.spv
*.wav
*.xma
*.ogg
*.opus
*.mp3
*.mp4
*.bik
*.bk2
*.awc
*.zip
*.7z
*.rar
*.tar
*.tgz
*.gz

# Editor / OS noise
.vs/
.idea/
*.swp
Thumbs.db
.DS_Store
